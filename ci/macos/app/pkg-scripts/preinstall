#!/bin/bash
# Stop the old supervisor and earlier hand-made kmonad LaunchDaemons.
for l in io.github.zikisoy.kmonad.supervisor local.kmonad.macbook org.pqrs.Karabiner-VirtualHIDDevice-Daemon.kmonad; do
  launchctl bootout "system/$l" 2>/dev/null || true
  # wait until launchd has really unloaded it, or a quick re-bootstrap fails
  for _ in $(seq 1 20); do launchctl print "system/$l" >/dev/null 2>&1 || break; sleep 0.5; done
done
rm -f /Library/LaunchDaemons/local.kmonad.macbook.plist \
      /Library/LaunchDaemons/org.pqrs.Karabiner-VirtualHIDDevice-Daemon.kmonad.plist
pkill -x KMonad 2>/dev/null || true
exit 0
