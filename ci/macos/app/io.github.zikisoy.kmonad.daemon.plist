<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Registered by KMonad.app with SMAppService (drag-to-Applications install). -->
  <key>Label</key><string>io.github.zikisoy.kmonad.daemon</string>
  <key>BundleProgram</key><string>Contents/MacOS/KMonad</string>
  <key>ProgramArguments</key>
  <array><string>KMonad</string><string>--supervisor</string></array>
  <key>AssociatedBundleIdentifiers</key>
  <array><string>io.github.zikisoy.kmonad</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
