<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>io.github.zikisoy.kmonad.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/KMonad.app/Contents/MacOS/KMonad</string>
    <string>--daemon</string>
  </array>
  <key>AssociatedBundleIdentifiers</key>
  <array><string>io.github.zikisoy.kmonad</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>/Library/Logs/KMonad/daemon.log</string>
  <key>StandardErrorPath</key><string>/Library/Logs/KMonad/daemon.log</string>
</dict>
</plist>
